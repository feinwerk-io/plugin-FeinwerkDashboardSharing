{# Banner on Matomo's admin home and context box on Matomo's report pages, Feinwerk promotion kit (docs/promo-kit.md).
   promo = PromoLine::variables() {id, placement, title, text, link, url, dismissDays}; hiding for 30 days and once per
   page in javascripts/promo.js. #}
<aside class="fwpromo-box{% if promo.placement == 'adminHome' %} fwpromo-box--banner{% endif %}"
       data-fwpromo-id="{{ promo.id }}" data-fwpromo-placement="{{ promo.placement }}" data-fwpromo-days="{{ promo.dismissDays }}"
       aria-label="{{ 'FeinwerkDashboardSharing_PromoTip'|translate }}">
    <div class="fwpromo-box__body">
        <p class="fwpromo-box__label">{{ 'FeinwerkDashboardSharing_PromoTip'|translate }}</p>
        <p class="fwpromo-box__title">{{ promo.title }}</p>
        <p class="fwpromo-box__text">{{ promo.text }}</p>
        <a class="fwpromo-box__link" href="{{ promo.url }}" target="_blank" rel="noopener">{{ promo.link }}</a>
    </div>
    <button type="button" class="fwpromo-box__dismiss fwpromo-dismiss" title="{{ 'FeinwerkDashboardSharing_PromoDismiss'|translate }}"
            aria-label="{{ 'FeinwerkDashboardSharing_PromoDismiss'|translate }}"><span aria-hidden="true">&times;</span></button>
</aside>
